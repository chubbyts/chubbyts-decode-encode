{
  "name": "@chubbyts/chubbyts-decode-encode",
  "type": "module",
  "version": "2.1.2",
  "description": "A simple decode/encode solution for json / jsonx / url-encoded / xml / yaml.",
  "keywords": [
    "chubbyts",
    "decode",
    "encode",
    "json",
    "jsonx",
    "url-encoded",
    "xml",
    "yaml"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/chubbyts-decode-encode",
  "scripts": {
    "build": "tsc",
    "cs-fix": "prettier --write src tests",
    "cs": "prettier --check src tests",
    "infection": "stryker run",
    "lint-fix": "eslint src tests eslint.config.js vitest.config.ts --fix",
    "lint": "eslint src tests",
    "prepare": "pnpm run build",
    "test": "vitest"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./dist": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/decoder": {
      "types": "./dist/decoder/index.d.ts",
      "import": "./dist/decoder/index.js",
      "default": "./dist/decoder/index.js"
    },
    "./dist/encoder": {
      "types": "./dist/encoder/index.d.ts",
      "import": "./dist/encoder/index.js",
      "default": "./dist/encoder/index.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "import": "./*.js",
      "default": "./*.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@chubbyts/chubbyts-throwable-to-error": "^2.0.4",
    "fast-xml-parser": "^5.5.6",
    "qs": "^6.15.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-eslint": "^5.0.0",
    "@chubbyts/chubbyts-function-mock": "^2.0.4",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/node": "^25.5.0",
    "@types/qs": "^6.15.0",
    "@vitest/coverage-v8": "^4.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
